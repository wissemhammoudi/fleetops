<div class="border-t pt-3 space-y-2" data-test-delivery-handover>
    <h4 class="font-semibold">{{t "collection-delivery.title"}}</h4>
    <p>{{t "collection-delivery.help"}}</p>
    {{#if this.leg}}
        <p>{{this.leg.status}} - {{this.leg.driver_uuid}}</p>
        <p>{{t "collection-depot.delivery-date"}}: {{this.leg.manifest.delivery_date}}</p>
        <p>{{this.leg.manifest.depot.name}} - {{this.leg.manifest.depot.street1}}</p>
        {{#if this.routing}}
            <section class="border rounded p-3" data-test-delivery-route>
                <h5>{{t "planning.optimizer.delivery-run"}}</h5>
                <p>{{this.routing.plan_uuid}} - {{this.routing.order_sequence}} / {{this.routing.order_uuids.length}}</p>
                <p>{{this.routing.origin.name}} &rarr; {{this.routing.destination.name}}</p>
                <ol>{{#each this.routing.stops as |stop|}}<li>{{stop.sequence}}. {{stop.order_id}} - {{stop.label}} - {{stop.arrival_at}}</li>{{/each}}</ol>
                <p>{{t "planning.optimizer.handover-help"}}</p>
            </section>
        {{/if}}
        {{#each this.leg.manifest.dropoffs as |stop|}}<p>{{stop.name}} - {{stop.street1}} - {{stop.phone}}</p>{{/each}}
        {{#each this.leg.manifest.units as |unit|}}<p>{{unit.barcode}} - {{unit.name}} - {{unit.staged_at}}</p>{{/each}}
    {{/if}}
    {{#if this.released}}
        <p>{{t "collection-delivery.released"}}</p>
    {{else}}
        {{#if (and this.movable @permissions.assign-delivery)}}
            <InputGroup @name={{t "collection-depot.delivery-date"}}>
                <input type="date" class="form-input" value={{this.deliveryDate}} {{on "change" this.selectDate}} aria-label={{t "collection-depot.delivery-date"}} />
            </InputGroup>
            <Button @text={{t "planning.move-draft"}} @onClick={{fn this.confirm "reschedule"}} @disabled={{or this.save.isRunning (not this.deliveryDate)}} />
        {{/if}}
        {{#if (and this.assignable @permissions.assign-delivery)}}
            <label class="block">
                {{t "collection-delivery.driver"}}
                <select class="form-select w-full" disabled={{this.save.isRunning}} {{on "change" this.selectDriver}} data-test-delivery-driver>
                    <option value="">{{t "collection-rounds.choose-driver"}}</option>
                    {{#each @drivers as |driver|}}<option value={{driver.uuid}} selected={{eq driver.uuid this.driver}}>{{driver.name}}</option>{{/each}}
                </select>
            </label>
            <Button @text={{t "collection-delivery.assign"}} @onClick={{perform this.save "assign"}} @disabled={{or this.save.isRunning (not this.driver)}} data-test-delivery-assign />
        {{/if}}
        {{#if (and this.staging @permissions.load-delivery)}}
            <InputGroup @name={{t "collection-delivery.barcode"}}>
                <Input @value={{this.barcode}} disabled={{this.save.isRunning}} class="form-input w-full" data-test-delivery-barcode />
            </InputGroup>
            <Button @text={{t "collection-delivery.load"}} @onClick={{perform this.save "load"}} @disabled={{or this.save.isRunning (not this.barcode)}} data-test-delivery-load />
        {{/if}}
        {{#if (and this.accepted @permissions.release-delivery)}}
            <Button @text={{t "collection-delivery.release"}} @onClick={{fn this.confirm "release"}} @disabled={{or this.save.isRunning (not @order.eligible)}} data-test-delivery-release />
        {{/if}}
        {{#if (and this.leg @permissions.recall-delivery)}}
            <InputGroup @name={{t "collection-delivery.reason"}}>
                <Textarea @value={{this.reason}} disabled={{this.save.isRunning}} class="form-input w-full" data-test-delivery-reason />
            </InputGroup>
            <Button @text={{t "collection-delivery.recall"}} @onClick={{fn this.confirm "recall"}} @disabled={{or this.save.isRunning (not this.reason)}} data-test-delivery-recall />
        {{/if}}
    {{/if}}
</div>