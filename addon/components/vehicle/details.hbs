<div class="details-wrapper" ...attributes>
    {{! VEHICLE }}
    <ContentPanel @title={{t "vehicle-tn.sections.vehicle"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">
            <div class="field-info-container">
                <div class="field-name">{{t "common.name"}}</div>
                <div class="field-value">{{n-a @resource.name}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle.fields.plate-number"}}</div>
                <div class="field-value">{{n-a @resource.plate_number}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle-tn.fields.type"}}</div>
                <div class="field-value">{{n-a this.typeLabel}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle.fields.make"}}</div>
                <div class="field-value">{{n-a @resource.make}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle.fields.model"}}</div>
                <div class="field-value">{{n-a @resource.model}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle.fields.year"}}</div>
                <div class="field-value">{{n-a @resource.year}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle-tn.fields.color"}}</div>
                <div class="field-value">{{n-a @resource.color}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle-tn.fields.fuel"}}</div>
                <div class="field-value">{{n-a this.fuelLabel}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle-tn.fields.ownership"}}</div>
                <div class="field-value">{{n-a this.ownershipLabel}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle.fields.driver-assigned"}}</div>
                <div class="field-value">
                    <Driver::Pill @driver={{resource-relation @resource "driver"}} @titleFallback={{n-a @resource.driver_name (t "common.no-driver-assigned")}} />
                </div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "common.status"}}</div>
                <div class="field-value">{{n-a (smart-humanize @resource.status)}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "common.internal-id"}}</div>
                <div class="field-value">{{n-a @resource.internal_id}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle.fields.vin-number"}}</div>
                <div class="field-value">{{n-a @resource.vin}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "vehicle-tn.fields.odometer"}}</div>
                <div class="field-value">{{#if @resource.odometer}}{{@resource.odometer}} km{{else}}{{n-a null}}{{/if}}</div>
            </div>

            <div class="field-info-container">
                <div class="field-name">{{t "common.coordinates"}}</div>
                <div class="field-value">{{point-coordinates @resource.location}}</div>
            </div>
        </div>
    </ContentPanel>

    {{! CAPACITY }}
    <ContentPanel @title={{t "vehicle-tn.sections.capacity"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-2 text-xs dark:text-gray-100" data-test-vehicle-capacity-details>
            <div class="field-info-container">
                <div class="field-name">{{t "vehicle-tn.fields.parcels"}}</div>
                <div class="field-value">{{n-a @resource.payload_capacity_parcels}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "vehicle-tn.fields.weight"}}</div>
                <div class="field-value">{{#if @resource.payload_capacity}}{{@resource.payload_capacity}} kg{{else}}{{n-a null}}{{/if}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "vehicle-tn.fields.volume"}}</div>
                <div class="field-value">{{#if @resource.payload_capacity_volume}}{{@resource.payload_capacity_volume}} m³{{else}}{{n-a null}}{{/if}}</div>
            </div>
        </div>
        {{#unless (and @resource.payload_capacity_parcels @resource.payload_capacity @resource.payload_capacity_volume)}}
            <div class="mt-2 rounded-md border border-yellow-300 bg-yellow-50 px-3 py-2 text-xs text-yellow-800 dark:border-yellow-700 dark:bg-yellow-900 dark:text-yellow-100">
                <FaIcon @icon="triangle-exclamation" class="mr-1" />{{t "vehicle-tn.no-capacity"}}
            </div>
        {{/unless}}
    </ContentPanel>

    {{! TUNISIAN PAPERS }}
    <ContentPanel @title={{t "vehicle-tn.sections.papers"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100" data-test-vehicle-papers-details>
            <div class="field-info-container">
                <div class="field-name">{{t "vehicle-tn.fields.carte_grise_number"}}</div>
                <div class="field-value">{{n-a this.papers.carte_grise_number}}</div>
            </div>
            {{#each this.paperDates as |date|}}
                <div class="field-info-container">
                    <div class="field-name">{{t (concat "vehicle-tn.fields." date.kind)}}</div>
                    <div class="field-value flex flex-row items-center space-x-2">
                        <span>{{n-a date.value}}</span>
                        <VehiclePaperBadge @status={{date.status}} />
                    </div>
                </div>
            {{/each}}
        </div>
        <div class="mt-2 space-y-2 text-xs">
            {{#each this.paperDocuments as |document|}}
                <div class="flex items-center justify-between rounded-md border border-gray-200 dark:border-gray-700 px-3 py-2">
                    <div class="font-semibold dark:text-gray-100">{{t (concat "vehicle-tn.documents." document.kind)}}</div>
                    {{#if document.uuid}}
                        <Button @type="default" @size="xs" @icon="eye" @text={{t "vehicle-tn.view-document"}} @onClick={{fn this.viewPaper document.uuid}} />
                    {{else}}
                        <span class="text-gray-500 dark:text-gray-400">{{t "vehicle-tn.document-missing"}}</span>
                    {{/if}}
                </div>
            {{/each}}
        </div>
    </ContentPanel>

    {{! PLANNING }}
    {{#if (or @resource.skills.length @resource.time_window_start @resource.time_window_end @resource.max_tasks)}}
        <ContentPanel @title={{t "vehicle-tn.sections.planning"}} @open={{true}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-2 gap-2 text-xs dark:text-gray-100">
                {{#if @resource.skills.length}}
                    <div class="field-info-container col-span-2">
                        <div class="field-name">{{t "vehicle-tn.fields.skills"}}</div>
                        <div class="field-value">{{join @resource.skills ", "}}</div>
                    </div>
                {{/if}}
                {{#if (or @resource.time_window_start @resource.time_window_end)}}
                    <div class="field-info-container">
                        <div class="field-name">{{t "vehicle-tn.fields.available_from"}}</div>
                        <div class="field-value">{{n-a @resource.time_window_start}}</div>
                    </div>
                    <div class="field-info-container">
                        <div class="field-name">{{t "vehicle-tn.fields.available_until"}}</div>
                        <div class="field-value">{{n-a @resource.time_window_end}}</div>
                    </div>
                {{/if}}
                {{#if @resource.max_tasks}}
                    <div class="field-info-container">
                        <div class="field-name">{{t "vehicle-tn.fields.max_tasks"}}</div>
                        <div class="field-value">{{@resource.max_tasks}}</div>
                    </div>
                {{/if}}
            </div>
        </ContentPanel>
    {{/if}}

    {{! CUSTOM FIELDS (view mode) }}
    <CustomField::Yield @subject={{@resource}} @viewMode={{true}} @wrapperClass="bordered-top" />

    {{! AVATAR }}
    <ContentPanel @title={{t "common.avatar"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="flex px-1">
            <div class="border border-dashed border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-600 rounded-lg flex items-center justify-center">
                <div class="flex items-center justify-center h-20 w-24">
                    <Image
                        alt={{@resource.displayName}}
                        src={{or @resource.avatar_custom_url @resource.avatar_url}}
                        @fallbackSrc={{config "defaultValues.vehicleAvatar"}}
                        class="w-12 h-12"
                    />
                </div>
            </div>
        </div>
    </ContentPanel>

    <RegistryYield @registry="fleet-ops:component:vehicle:details" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>

    <Spacer @height="300px" />
</div>