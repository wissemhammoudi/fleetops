<div class="form-wrapper" ...attributes>
    <RegistryYield @registry="fleet-ops:component:vehicle:form:start" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{this.controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>

    {{! VEHICLE }}
    <ContentPanel @title={{t "vehicle-tn.sections.vehicle"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="flex flex-row space-x-3 mb-3">
            <div class="flex items-center justify-start rounded-full">
                <Image
                    src={{resource-image @resource.photo_url "vehicle"}}
                    @fallbackSrc={{(placeholder-image "vehicle")}}
                    alt={{@resource.name}}
                    height="48"
                    width="48"
                    class="h-14 w-14 rounded-full shadow-sm"
                />
                <Attach::Tooltip @class="clean" @animation="scale" @placement="top">
                    <InputInfo @text={{t "vehicle.fields.upload-new-photo"}} />
                </Attach::Tooltip>
            </div>
            <div>
                <UploadButton
                    @name={{t "common.photos"}}
                    @accept="image/*"
                    @onFileAdded={{perform this.handlePhotoUpload}}
                    @icon="upload"
                    @size="xs"
                    @buttonText={{t "common.upload-image"}}
                    @disabled={{cannot-write @resource}}
                />
                <div class="px-1">
                    <span class="text-gray-300 dark:text-gray-600 text-xs">{{t "common.upload-image-supported"}}</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <InputGroup @name={{t "common.name"}}>
                <Input @value={{@resource.name}} @type="text" class="w-full form-input" placeholder={{t "common.name"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "vehicle.fields.plate-number"}} @helpText={{t "vehicle-tn.help.plate"}}>
                <Input @value={{@resource.plate_number}} @type="text" class="w-full form-input" placeholder="123 TU 4567" disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "vehicle-tn.fields.type"}} @helpText={{t "vehicle-tn.help.type"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select" data-test-vehicle-type>
                    <PowerSelect
                        @options={{this.typeOptions}}
                        @selected={{this.selectedType}}
                        @onChange={{this.selectType}}
                        @placeholder={{t "vehicle-tn.fields.type"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "vehicle.fields.make"}}>
                <Input @value={{@resource.make}} @type="text" class="w-full form-input" placeholder={{t "vehicle.fields.vehicle-make"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "vehicle.fields.model"}}>
                <Input @value={{@resource.model}} @type="text" class="w-full form-input" placeholder={{t "vehicle.fields.vehicle-model"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "vehicle.fields.year"}}>
                <Input @value={{@resource.year}} @type="text" class="w-full form-input" placeholder={{t "vehicle.fields.vehicle-year"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "vehicle-tn.fields.color"}}>
                <Input @value={{@resource.color}} @type="text" class="w-full form-input" placeholder={{t "vehicle-tn.fields.color"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "vehicle-tn.fields.fuel"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.fuelOptions}}
                        @selected={{this.selectedFuel}}
                        @onChange={{this.selectFuel}}
                        @placeholder={{t "vehicle-tn.fields.fuel"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "vehicle-tn.fields.ownership"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{this.ownershipOptions}}
                        @selected={{this.selectedOwnership}}
                        @onChange={{this.selectOwnership}}
                        @placeholder={{t "vehicle-tn.fields.ownership"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "vehicle.fields.driver-assigned"}}>
                <ModelSelect
                    @modelName="driver"
                    @selectedItemComponent={{component "select-option/driver" compact=true}}
                    @selectedModel={{@resource.driver}}
                    @placeholder={{t "vehicle.fields.select-driver"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.assignDriver}}
                    @permission="fleet-ops assign-driver-for vehicle"
                    as |model|
                >
                    <SelectOption::Driver @option={{model}} />
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "common.status"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{get-fleet-ops-options "vehicleStatuses"}}
                        @selected={{find-by "value" @resource.status (get-fleet-ops-options "vehicleStatuses")}}
                        @onChange={{set-model-attr @resource "status"}}
                        @placeholder={{t "common.status"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        <div class="text-sm">
                            <div class="font-semibold normalize-in-trigger">{{option.label}}</div>
                            <div class="hide-from-trigger">{{option.description}}</div>
                        </div>
                    </PowerSelect>
                </div>
            </InputGroup>

            <InputGroup @name={{t "common.internal-id"}}>
                <Input @value={{@resource.internal_id}} @type="text" class="w-full form-input" placeholder={{t "common.internal-id"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "vehicle.fields.vin-number"}}>
                <Input @value={{@resource.vin}} @type="text" class="w-full form-input" placeholder={{t "vehicle.fields.vin-number"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "vehicle-tn.fields.odometer"}}>
                <UnitInput class="w-full" @value={{@resource.odometer}} @unit="km" @placeholder={{t "vehicle-tn.fields.odometer"}} />
            </InputGroup>
        </div>

        <RegistryYield @registry="fleet-ops:component:vehicle:form:details" as |RegistryComponent|>
            <RegistryComponent @resource={{@resource}} @controller={{this.controller}} @permission={{get-write-permission @resource}} />
        </RegistryYield>
    </ContentPanel>

    <RegistryYield @registry="fleet-ops:component:vehicle:form:after-details" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{this.controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>

    {{! CAPACITY }}
    <ContentPanel @title={{t "vehicle-tn.sections.capacity"}} @open={{true}} @wrapperClass="bordered-top">
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-2">{{t "vehicle-tn.help.capacity"}}</p>
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-3 lg:gap-2 no-input-group-padding text-xs" data-test-vehicle-capacity>
            <InputGroup @name={{t "vehicle-tn.fields.parcels"}} @required={{true}}>
                <Input
                    @value={{@resource.payload_capacity_parcels}}
                    @type="number"
                    min="1"
                    step="1"
                    required
                    class="form-input w-full"
                    placeholder="40"
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>
            <InputGroup @name={{t "vehicle-tn.fields.weight"}} @required={{true}}>
                <UnitInput class="w-full" @value={{@resource.payload_capacity}} @unit="kg" @placeholder="250" />
            </InputGroup>
            <InputGroup @name={{t "vehicle-tn.fields.volume"}} @required={{true}}>
                <Input
                    @value={{@resource.payload_capacity_volume}}
                    @type="number"
                    min="0.01"
                    step="0.01"
                    required
                    class="form-input w-full"
                    placeholder="1"
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>
        </div>
    </ContentPanel>

    {{! TUNISIAN PAPERS }}
    <ContentPanel @title={{t "vehicle-tn.sections.papers"}} @open={{true}} @wrapperClass="bordered-top">
        <p class="text-xs text-gray-500 dark:text-gray-400 mb-2">{{t "vehicle-tn.help.papers"}}</p>
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs" data-test-vehicle-papers>
            <InputGroup @name={{t "vehicle-tn.fields.carte_grise_number"}}>
                <input
                    type="text"
                    maxlength="50"
                    value={{this.papers.carte_grise_number}}
                    class="w-full form-input"
                    placeholder={{t "vehicle-tn.fields.carte_grise_number"}}
                    disabled={{cannot-write @resource}}
                    {{on "input" (fn this.setPaper "carte_grise_number")}}
                />
            </InputGroup>
            {{#each this.paperDates as |date|}}
                <InputGroup @name={{t (concat "vehicle-tn.fields." date.kind)}}>
                    <div class="flex flex-row items-center space-x-2">
                        <input
                            type="date"
                            value={{date.value}}
                            class="w-full form-input"
                            disabled={{cannot-write @resource}}
                            data-test-vehicle-paper-date={{date.kind}}
                            {{on "change" (fn this.setPaper date.kind)}}
                        />
                        {{#if date.status}}
                            <VehiclePaperBadge @status={{date.status}} />
                        {{/if}}
                    </div>
                </InputGroup>
            {{/each}}
        </div>
        <div class="mt-2 space-y-2 text-xs">
            {{#each this.paperDocuments as |document|}}
                <div class="flex items-center justify-between rounded-md border border-gray-200 dark:border-gray-700 px-3 py-2" data-test-vehicle-paper-document={{document.kind}}>
                    <div>
                        <div class="font-semibold dark:text-gray-100">{{t (concat "vehicle-tn.documents." document.kind)}}</div>
                        <div class="text-gray-500 dark:text-gray-400">
                            {{#if document.uuid}}
                                <FaIcon @icon="circle-check" class="text-green-500 mr-1" />{{t "vehicle-tn.document-uploaded"}}
                            {{else}}
                                {{t "vehicle-tn.document-missing"}}
                            {{/if}}
                        </div>
                    </div>
                    <div class="flex flex-row items-center space-x-1">
                        {{#if document.uuid}}
                            <Button @type="default" @size="xs" @icon="eye" @text={{t "vehicle-tn.view-document"}} @onClick={{fn this.viewPaper document.uuid}} />
                        {{/if}}
                        <UploadButton
                            @name={{concat "vehicle-paper-" document.kind}}
                            @accept="application/pdf,image/jpeg,image/png"
                            @onFileAdded={{perform this.uploadPaper document.kind}}
                            @icon="upload"
                            @size="xs"
                            @buttonText={{if document.uuid (t "vehicle-tn.replace-document") (t "vehicle-tn.upload-document")}}
                            @disabled={{or (cannot-write @resource) this.uploadPaper.isRunning}}
                        />
                    </div>
                </div>
            {{/each}}
        </div>
    </ContentPanel>

    {{! PLANNING }}
    <ContentPanel @title={{t "vehicle-tn.sections.planning"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <div class="col-span-1 lg:col-span-2">
                <InputGroup @name={{t "vehicle-tn.fields.skills"}} @helpText={{t "vehicle-tn.help.skills"}}>
                    <MultiSelect
                        @options={{get-fleet-ops-options "vehicleSkills"}}
                        @selected={{@resource.skills}}
                        @onChange={{fn (mut @resource.skills)}}
                        @placeholder={{t "vehicle-tn.fields.skills"}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </MultiSelect>
                </InputGroup>
            </div>
            <InputGroup @name={{t "vehicle-tn.fields.available_from"}}>
                <Input @value={{@resource.time_window_start}} @type="time" class="form-input w-full" placeholder="HH:MM" disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "vehicle-tn.fields.available_until"}}>
                <Input @value={{@resource.time_window_end}} @type="time" class="form-input w-full" placeholder="HH:MM" disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "vehicle-tn.fields.max_tasks"}} @helpText={{t "vehicle-tn.help.max_tasks"}}>
                <Input @value={{@resource.max_tasks}} @type="number" min="1" class="form-input w-full" placeholder="20" disabled={{cannot-write @resource}} />
            </InputGroup>
        </div>
    </ContentPanel>

    {{! CUSTOM FIELDS, REGISTRY, AVATAR }}
    <CustomField::Yield @subject={{@resource}} @wrapperClass="bordered-top" />

    <RegistryYield @registry="fleet-ops:component:vehicle:form" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{this.controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>

    <ContentPanel @title={{t "avatar-picker.avatar"}} @open={{true}} @wrapperClass="bordered-top">
        <AvatarPicker @model={{@resource}} @defaultAvatar={{config "defaultValues.vehicleAvatar"}} @disabled={{cannot-write @resource}} />
    </ContentPanel>

    <RegistryYield @registry="fleet-ops:component:vehicle:form:end" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{this.controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>
</div>