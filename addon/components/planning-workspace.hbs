<div class="flex flex-col h-full overflow-hidden">
    <div class="flex gap-2 p-3 border-b dark:border-gray-700" aria-label={{t "planning.workspace"}}>
        {{#if this.collectionPlanning.canRead}}
            <Button @text={{t "planning.pickups"}} @type={{if (eq this.activeSection "pickups") "primary" "default"}} @onClick={{fn this.select "pickups"}} data-test-planning-pickups />
            <Button @text={{t "planning.depot"}} @type={{if (eq this.activeSection "depot") "primary" "default"}} @onClick={{fn this.select "depot"}} data-test-planning-depot />
        {{/if}}
        {{#if this.canPlanOrders}}
            <Button @text={{t "planning.other-orders"}} @type={{if (eq this.activeSection "orders") "primary" "default"}} @onClick={{fn this.select "orders"}} data-test-planning-orders />
        {{/if}}
    </div>
    <div class="flex-1 min-h-0 overflow-hidden">
        {{#if (eq this.activeSection "orders")}}
            <OrchestratorWorkbench />
        {{else}}
            <CollectionRounds @view={{this.activeSection}} />
        {{/if}}
    </div>
</div>
