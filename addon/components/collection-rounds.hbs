<div class="p-6 space-y-4 overflow-y-auto h-full">
    <h1 class="text-xl font-semibold">{{t "collection-rounds.title"}}</h1>
    <p>{{t "collection-rounds.help"}}</p>
    <Button @text={{t "collection-rounds.refresh"}} @onClick={{perform this.load}} @disabled={{or this.load.isRunning this.update.isRunning this.plan.isRunning}} />
    {{#if this.permissions.plan}}
        <Button @text={{t "collection-rounds.plan"}} @onClick={{perform this.plan}} @disabled={{or this.load.isRunning this.update.isRunning this.plan.isRunning}} data-test-plan-rounds />
    {{/if}}
    {{#each this.warnings as |warning|}}
        <p role="alert">{{warning.order_uuid}}: {{warning.message}}</p>
    {{/each}}
    {{#if this.loaded}}
        <section aria-label="Pickup follow-up" class="space-y-2">
            <h2>{{t "collection-rounds.follow-up"}} ({{this.followupTotal}})</h2>
            <p>{{t "collection-rounds.follow-up-help"}}</p>
            {{#each this.followupCards as |order|}}
                <p>{{order.order_id}} - {{order.state}} - {{order.parcel_count}} {{t "collection-rounds.parcels"}}</p>
                {{#if order.pickup_window}}<p>{{t "collection-rounds.pickup-window"}}: {{order.pickupDate}} {{order.pickup_window.label}} ({{order.timezone}})</p>{{/if}}
                {{#if order.error}}<p role="alert">{{order.error}}</p>{{/if}}
                {{#each order.stops as |stop|}}
                    <p>{{stop.contact.name}}
                        -
                        {{stop.contact.street1}}
                        -
                        {{stop.contact.phone}}
                        {{#if stop.callUrl}}<a href={{stop.callUrl}}>{{t "collection-rounds.call-customer"}}</a>{{else}}{{t "collection-rounds.phone-missing"}}{{/if}}
                    </p>
                {{/each}}
            {{/each}}
            <p>{{this.followupPage}} / {{this.followupLastPage}}</p>
            <button type="button" disabled={{or this.firstFollowupPage this.load.isRunning}} {{on "click" (fn this.pageFollowup -1)}}>{{t "collection-rounds.previous"}}</button>
            <button type="button" disabled={{or this.lastFollowupPage this.load.isRunning}} {{on "click" (fn this.pageFollowup 1)}}>{{t "collection-rounds.next"}}</button>
        </section>
        {{#each this.cards as |round|}}
            <section class="border rounded p-4 space-y-3" data-test-pickup-round>
                <h2 class="font-semibold">{{round.departure}} ({{round.timezone}}) - {{round.status}}</h2>
                <p>{{t "collection-rounds.reference"}}: {{round.uuid}}</p>
                <p>{{round.order_count}}
                    {{t "collection-rounds.orders"}}
                    -
                    {{round.parcel_count}}
                    {{t "collection-rounds.parcels"}}
                    -
                    {{round.pickup_count}}
                    {{t "collection-rounds.stops"}}</p>
                {{#if round.pickup_window}}<p>{{t "collection-rounds.pickup-window"}}: {{round.pickup_window.label}} ({{round.timezone}})</p>{{/if}}
                {{#if round.parcel_capacity}}<p>{{t "collection-rounds.capacity"}}: {{round.parcel_capacity}}</p>{{/if}}
                {{#each round.suggested_drivers as |driver|}}<p>{{t "collection-rounds.suggested-driver"}}: {{driver.name}} ({{driver.parcel_capacity}})</p>{{/each}}
                {{#if round.assignable}}
                    <label class="block">
                        {{t "collection-rounds.driver"}}
                        <select class="form-select w-full" value={{round.selectedDriver}} {{on "change" (fn this.select round.uuid "driver")}} data-test-round-driver>
                            <option value="">{{t "collection-rounds.choose-driver"}}</option>
                            {{#each this.drivers as |driver|}}
                                <option value={{driver.uuid}} selected={{eq driver.uuid round.selectedDriver}}>{{driver.name}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <label class="block">
                        {{t "collection-rounds.depot"}}
                        <select class="form-select w-full" value={{round.selectedDepot}} {{on "change" (fn this.select round.uuid "depot")}} data-test-round-depot>
                            <option value="">{{t "collection-rounds.choose-depot"}}</option>
                            {{#each this.depots as |depot|}}
                                <option value={{depot.uuid}} selected={{eq depot.uuid round.selectedDepot}}>{{depot.name}} - {{depot.street1}}</option>
                            {{/each}}
                        </select>
                    </label>
                    <Button
                        @text={{t "collection-rounds.assign"}}
                        @onClick={{perform this.update round "assign"}}
                        @disabled={{or this.update.isRunning this.load.isRunning this.plan.isRunning}}
                        data-test-round-assign
                    />
                {{/if}}
                {{#if (and round.draft this.permissions.release)}}
                    <Button
                        @text={{t "collection-rounds.release"}}
                        @onClick={{fn this.confirm round "release"}}
                        @disabled={{or this.update.isRunning this.load.isRunning this.plan.isRunning}}
                        data-test-round-release
                    />
                {{/if}}
                {{#if (and round.editable this.permissions.cancel)}}
                    <Button
                        @text={{t "collection-rounds.cancel"}}
                        @onClick={{fn this.confirm round "cancel"}}
                        @disabled={{or this.update.isRunning this.load.isRunning this.plan.isRunning}}
                    />
                {{/if}}
                {{#each round.stops as |stop|}}
                    <p>{{stop.order_id}} - {{stop.contact.name}} - {{stop.contact.street1}} - {{stop.contact.phone}} - {{stop.status}} {{stop.reason}}</p>
                    {{#if stop.callUrl}}<a href={{stop.callUrl}}>{{t "collection-rounds.call-customer"}}</a>{{/if}}
                    <p>{{stop.notes}}</p>
                    <p>{{t "collection-rounds.order-parcels"}}:
                        {{#each stop.order_parcels as |parcel|}}{{parcel.name}} x{{parcel.quantity}}; {{/each}}
                    </p>
                {{/each}}
                {{#if round.depot}}
                    <p>{{t "collection-rounds.return-depot"}}: {{round.depot.name}} - {{round.depot.street1}} - {{round.depot.phone}}</p>
                {{/if}}
                {{#if round.custody}}
                    <CollectionDepot @round={{round}} @drivers={{this.drivers}} @permissions={{this.permissions}} @onChanged={{perform this.load}} />
                {{/if}}
            </section>
        {{else}}
            <p>{{t "collection-rounds.empty"}}</p>
        {{/each}}
    {{/if}}
</div>