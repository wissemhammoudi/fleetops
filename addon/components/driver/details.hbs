<div class="details-wrapper" ...attributes>
    <ContentPanel @title={{t "common.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-2 text-xs dark:text-gray-100">
            <div class="field-info-container md:col-span-3">
                <div class="field-name">{{t "common.name"}}</div>
                <div class="field-value">{{n-a @resource.name}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "common.phone"}}</div>
                <ClickToCopy @value={{@resource.phone}} class="field-value">{{n-a @resource.phone}}</ClickToCopy>
            </div>
            <div class="field-info-container md:col-span-2">
                <div class="field-name">{{t "common.email"}}</div>
                <ClickToCopy @value={{@resource.email}} class="field-value">{{n-a @resource.email}}</ClickToCopy>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "common.id"}}</div>
                <ClickToCopy @value={{@resource.public_id}} class="field-value">{{n-a @resource.public_id}}</ClickToCopy>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "common.internal-id"}}</div>
                <div class="field-value">{{n-a @resource.internal_id}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "driver.fields.driver-license"}}</div>
                <div class="field-value">{{n-a @resource.drivers_license_number}}</div>
            </div>
            <div class="field-info-container md:col-span-3">
                <div class="field-name">{{t "driver.fields.license-expiry"}}</div>
                <div class="field-value">{{n-a (format-date-fns @resource.license_expiry)}}</div>
            </div>
            <div class="field-info-container md:col-span-2">
                <div class="field-name">{{t "resource.vehicle"}}</div>
                <div class="field-value">
                    <Vehicle::Pill @vehicle={{resource-relation @resource "vehicle"}} @titleFallback={{n-a @resource.vehicle_name (t "driver.fields.no-vehicle-assigned")}} />
                </div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "common.city"}}</div>
                <div class="field-value">{{n-a @resource.city}}</div>
            </div>
            <div class="field-info-container md:col-span-2">
                <div class="field-name">{{t "common.country"}}</div>
                <div class="field-value">
                    <CountryName @country={{@resource.country}} />
                </div>
            </div>
            <div class="field-info-container md:col-span-3">
                <div class="field-name">{{t "common.coordinates"}}</div>
                <div class="field-value">{{point-coordinates @resource.location}}</div>
            </div>
        </div>
    </ContentPanel>
    <ContentPanel @title={{t "driver-identity.verification-title"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="text-xs dark:text-gray-100" data-test-driver-verification>
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center space-x-2">
                    {{#if this.verification}}
                        <Badge @status={{this.statusBadge}}>{{t (concat "driver-identity.status." this.verification.status)}}</Badge>
                        {{#if (eq this.verification.status "verified")}}
                            <span class="text-gray-500 dark:text-gray-400">
                                {{t "driver-identity.verified-by" name=(n-a this.verification.verified_by) date=this.verifiedAt}}
                            </span>
                        {{/if}}
                    {{else if this.loadVerification.isRunning}}
                        <Spinner />
                    {{/if}}
                </div>
                <div class="flex flex-row space-x-1">
                    {{#if (and this.verification.can_verify (eq this.verification.status "verified"))}}
                        <Button @type="danger" @size="xs" @icon="ban" @text={{t "driver-identity.revoke"}} @onClick={{perform this.revoke}} @isLoading={{this.revoke.isRunning}} />
                    {{else if this.verification.can_verify}}
                        <Button
                            @type="primary"
                            @size="xs"
                            @icon="user-check"
                            @text={{t "driver-identity.verify"}}
                            @onClick={{perform this.verify}}
                            @isLoading={{this.verify.isRunning}}
                            @disabled={{not this.canVerify}}
                        />
                    {{/if}}
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-2">
                <div class="field-info-container">
                    <div class="field-name">{{t "driver-identity.driver-type"}}</div>
                    <div class="field-value">{{if this.identity.kind (t (concat "driver-identity.kinds." this.identity.kind)) (t "driver-identity.not-specified")}}</div>
                </div>
                <div class="field-info-container">
                    <div class="field-name">{{t "driver-identity.fields.cin"}}</div>
                    <div class="field-value">{{n-a this.identity.cin}}</div>
                </div>
                {{#if (eq this.identity.kind "freelance")}}
                    <div class="field-info-container">
                        <div class="field-name">{{t "driver-identity.fields.brand-name"}}</div>
                        <div class="field-value">{{n-a this.identity.brand_name}}</div>
                    </div>
                    <div class="field-info-container">
                        <div class="field-name">{{t "driver-identity.fields.tax-id"}}</div>
                        <div class="field-value">{{n-a this.identity.tax_id}}</div>
                    </div>
                    <div class="field-info-container">
                        <div class="field-name">{{t "driver-identity.fields.rne-id"}}</div>
                        <div class="field-value">{{n-a this.identity.rne_id}}</div>
                    </div>
                    <div class="field-info-container">
                        <div class="field-name">{{t "driver-identity.fields.tax-regime"}}</div>
                        <div class="field-value">{{if this.identity.tax_regime (t (concat "driver-identity.tax-regimes." this.identity.tax_regime)) "-"}}</div>
                    </div>
                    <div class="field-info-container md:col-span-3">
                        <div class="field-name">{{t "driver-identity.fields.rib"}}</div>
                        <div class="field-value">{{n-a this.identity.rib}}</div>
                    </div>
                {{/if}}
            </div>
            {{#if this.verification.documents.length}}
                <div class="mt-3 space-y-2">
                    {{#each this.verification.documents as |document|}}
                        <div class="flex items-center justify-between rounded-md border border-gray-200 dark:border-gray-700 px-3 py-2">
                            <span class="font-semibold">{{t (concat "driver-identity.documents." document.kind)}}</span>
                            <Button @type="default" @size="xs" @icon="eye" @text={{t "driver-identity.view-document"}} @onClick={{fn this.viewDocument document.uuid}} />
                        </div>
                    {{/each}}
                </div>
            {{/if}}
            {{#if (and this.problems.length (not-eq this.verification.status "verified"))}}
                <div class="mt-3 rounded-md border border-yellow-300 bg-yellow-50 dark:border-yellow-700 dark:bg-yellow-900/20 px-3 py-2 text-yellow-800 dark:text-yellow-200">
                    <div class="font-semibold mb-1">{{t "driver-identity.missing-before-verification"}}</div>
                    <ul class="list-disc pl-4">
                        {{#each this.problems as |problem|}}
                            <li>{{problem}}</li>
                        {{/each}}
                    </ul>
                </div>
            {{/if}}
        </div>
    </ContentPanel>
    <CustomField::Yield @subject={{@resource}} @viewMode={{true}} @wrapperClass="bordered-top" />

    <RegistryYield @registry="fleet-ops:component:driver:details" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{@controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>

    {{! ORCHESTRATOR CONSTRAINTS (read-only view) }}
    {{#if (or @resource.skills.length @resource.max_distance @resource.max_travel_time)}}
        <ContentPanel @title="Orchestrator Constraints" @open={{true}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-2 gap-2 text-xs dark:text-gray-100">
                {{#if @resource.skills.length}}
                    <div class="field-info-container col-span-2">
                        <div class="field-name">Skills & Certifications</div>
                        <div class="field-value">{{join @resource.skills ", "}}</div>
                    </div>
                {{/if}}
                {{#if @resource.max_travel_time}}
                    <div class="field-info-container">
                        <div class="field-name">Max Driving Time</div>
                        <div class="field-value">{{@resource.max_travel_time}} s</div>
                    </div>
                {{/if}}
                {{#if @resource.max_distance}}
                    <div class="field-info-container">
                        <div class="field-name">Max Distance</div>
                        <div class="field-value">{{@resource.max_distance}} m</div>
                    </div>
                {{/if}}
            </div>
        </ContentPanel>
    {{/if}}

    <ContentPanel
        @title={{t "common.metadata"}}
        @open={{true}}
        @actionButtons={{this.metadataButtons}}
        @wrapperClass="bordered-top"
        @panelBodyWrapperClass={{unless (is-object-empty @resource.meta) "px-0i" ""}}
    >
        <MetadataViewer @metadata={{@resource.meta}} />
    </ContentPanel>
</div>