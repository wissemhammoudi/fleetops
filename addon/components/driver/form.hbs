<div class="form-wrapper" ...attributes>
    <ContentPanel @title={{t "driver.fields.driver-details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="flex flex-row space-x-3 mb-3">
            <div class="flex items-center justify-start rounded-full">
                <Image
                    src={{resource-image @resource.photo_url "driver"}}
                    @fallbackSrc={{(placeholder-image "driver")}}
                    alt={{@resource.name}}
                    height="48"
                    width="48"
                    class="h-14 w-14 rounded-full shadow-sm"
                />
                <Attach::Tooltip @class="clean" @animation="scale" @placement="top">
                    <InputInfo @text={{t "common.upload-new-photo"}} />
                </Attach::Tooltip>
            </div>
            <div>
                <UploadButton
                    @name={{t "common.photos"}}
                    @accept="image/*"
                    @onFileAdded={{perform this.handlePhotoUpload}}
                    @icon="upload"
                    @size="xs"
                    @buttonText={{t "common.upload-image"}}
                    @disabled={{cannot-write @resource}}
                />
                <div class="px-1">
                    <span class="text-gray-300 dark:text-gray-600 text-xs">{{t "common.upload-image-supported"}}</span>
                </div>
            </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs no-input-group-padding">
            <InputGroup @name={{t "common.name"}} @required={{true}}>
                <Input @value={{@resource.name}} @type="text" class="w-full form-input" placeholder={{t "common.name"}} disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup @name={{t "common.email"}}>
                <Input
                    @value={{@resource.email}}
                    @type="text"
                    class="w-full form-input"
                    placeholder={{t "common.email"}}
                    disabled={{or (cannot-write @resource) @resource.is_staff_linked}}
                />
            </InputGroup>
            <InputGroup @name={{t "common.phone"}}>
                <PhoneInput @value={{@resource.phone}} @onInput={{fn (mut @resource.phone)}} class="form-input w-full" disabled={{or (cannot-write @resource) @resource.is_staff_linked}} />
            </InputGroup>
            {{#if @resource.is_staff_linked}}
                <div class="lg:col-span-2 -mt-1 mb-2 text-xs text-gray-500 dark:text-gray-400" data-test-staff-linked-helper>{{t "profile-account.staff-linked-helper"}}</div>
            {{else if @resource.isNew}}
                <ProfileIdentityHint @email={{@resource.email}} @phone={{@resource.phone}} @type="driver" class="lg:col-span-2" />
            {{/if}}
            <InputGroup @name={{t "common.internal-id"}}>
                <Input @value={{@resource.internal_id}} @type="text" class="w-full form-input" placeholder={{t "common.internal-id"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "driver.fields.driver-license"}}>
                <Input
                    @value={{@resource.drivers_license_number}}
                    @type="text"
                    class="w-full form-input"
                    placeholder={{t "driver.fields.driver-license"}}
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "driver.fields.license-expiry"}}>
                <DatePicker
                    @value={{@resource.license_expiry}}
                    @onChange={{fn (mut @resource.license_expiry)}}
                    @placeholder={{t "driver.fields.license-expiry"}}
                    @disabled={{cannot-write @resource}}
                    class="w-full form-input"
                />
            </InputGroup>

            <InputGroup @name={{t "resource.vehicle"}}>
                <ModelSelect
                    @modelName="vehicle"
                    @selectedItemComponent={{component "select-option/vehicle" compact=true}}
                    @selectedModel={{@resource.vehicle}}
                    @placeholder={{t "driver.fields.select-vehicle"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{fn (mut @resource.vehicle)}}
                    @onChangeId={{fn (mut @resource.vehicle_uuid)}}
                    @disabled={{cannot-write @resource}}
                    as |model|
                >
                    <SelectOption::Vehicle @option={{model}} />
                </ModelSelect>
            </InputGroup>

            <InputGroup @name={{t "vehicle-tn.capacity-from-vehicle"}}>
                <div class="form-input w-full bg-gray-50 dark:bg-gray-800 text-xs" data-test-driver-vehicle-capacity>
                    {{#if @resource.vehicle.id}}
                        {{#if (and @resource.vehicle.payload_capacity_parcels @resource.vehicle.payload_capacity @resource.vehicle.payload_capacity_volume)}}
                            {{t
                                "vehicle-tn.capacity-summary"
                                parcels=@resource.vehicle.payload_capacity_parcels
                                weight=@resource.vehicle.payload_capacity
                                volume=@resource.vehicle.payload_capacity_volume
                            }}
                        {{else}}
                            <span class="text-yellow-700 dark:text-yellow-300"><FaIcon @icon="triangle-exclamation" class="mr-1" />{{t "vehicle-tn.no-capacity"}}</span>
                        {{/if}}
                    {{else}}
                        <span class="text-yellow-700 dark:text-yellow-300"><FaIcon @icon="triangle-exclamation" class="mr-1" />{{t "vehicle-tn.no-vehicle"}}</span>
                    {{/if}}
                </div>
            </InputGroup>

            <InputGroup @name={{t "common.city"}}>
                <Input @value={{@resource.city}} @type="text" class="w-full form-input" placeholder={{t "common.city"}} disabled={{cannot-write @resource}} />
            </InputGroup>

            <InputGroup @name={{t "common.country"}}>
                <CountrySelect
                    class="w-full form-input form-select form-datalist"
                    @value={{@resource.country}}
                    @onChange={{fn (mut @resource.country)}}
                    disabled={{cannot-write @resource}}
                />
            </InputGroup>

            <InputGroup @name={{t "common.status"}}>
                <div class="fleetbase-model-select fleetbase-power-select ember-model-select">
                    <PowerSelect
                        @options={{get-fleet-ops-options "driverStatuses"}}
                        @selected={{find-by "value" @resource.status (get-fleet-ops-options "driverStatuses")}}
                        @onChange={{set-model-attr @resource "status"}}
                        @placeholder={{t "common.select-field" field=(t "common.status")}}
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |type|
                    >
                        <div class="text-sm">
                            <div class="font-semibold normalize-in-trigger">{{type.label}}</div>
                            <div class="hide-from-trigger">{{type.description}}</div>
                        </div>
                    </PowerSelect>
                </div>
            </InputGroup>
            <InputGroup @name={{t "common.coordinates"}} @wrapperClass="col-span-2">
                <ModelCoordinatesInput @model={{@resource}} @disabled={{cannot-write @resource}} @autocomplete="location" />
            </InputGroup>
        </div>
        <RegistryYield @registry="fleet-ops:component:driver:form:details" as |RegistryComponent|>
            <RegistryComponent @resource={{@resource}} @controller={{this.controller}} @permission={{get-write-permission @resource}} />
        </RegistryYield>
    </ContentPanel>

    {{! DRIVER TYPE & IDENTITY }}
    <ContentPanel @title={{t "driver-identity.title"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="text-xs no-input-group-padding" data-test-driver-identity>
            <label class="block mb-1.5">{{t "driver-identity.driver-type"}} <span class="text-red-500">*</span></label>
            <div class="flex flex-row space-x-1 mb-3">
                <Button
                    @type={{if (eq this.identityKind "team") "primary" "default"}}
                    @size="xs"
                    @icon="users"
                    @text={{t "driver-identity.kinds.team"}}
                    @onClick={{fn this.setIdentityKind "team"}}
                    @disabled={{cannot-write @resource}}
                />
                <Button
                    @type={{if (eq this.identityKind "freelance") "primary" "default"}}
                    @size="xs"
                    @icon="briefcase"
                    @text={{t "driver-identity.kinds.freelance"}}
                    @onClick={{fn this.setIdentityKind "freelance"}}
                    @disabled={{cannot-write @resource}}
                />
            </div>
            {{#if this.loadIdentity.isRunning}}
                <Spinner />
            {{else if this.identityKind}}
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-2">
                    <InputGroup @name={{t "driver-identity.fields.cin"}} @helpText={{t "driver-identity.fields.cin-help"}}>
                        <input
                            value={{this.identity.cin}}
                            type="text"
                            inputmode="numeric"
                            maxlength="8"
                            class="w-full form-input"
                            placeholder="12345678"
                            disabled={{cannot-write @resource}}
                            {{on "input" (fn this.setIdentityField "cin")}}
                        />
                    </InputGroup>
                    {{#if (eq this.identityKind "freelance")}}
                        <InputGroup @name={{t "driver-identity.fields.brand-name"}}>
                            <input
                                value={{this.identity.brand_name}}
                                type="text"
                                class="w-full form-input"
                                placeholder={{t "driver-identity.fields.brand-name"}}
                                disabled={{cannot-write @resource}}
                                {{on "input" (fn this.setIdentityField "brand_name")}}
                            />
                        </InputGroup>
                        <InputGroup @name={{t "driver-identity.fields.tax-id"}}>
                            <input
                                value={{this.identity.tax_id}}
                                type="text"
                                class="w-full form-input"
                                placeholder="1234567ABC000"
                                disabled={{cannot-write @resource}}
                                {{on "input" (fn this.setIdentityField "tax_id")}}
                            />
                        </InputGroup>
                        <InputGroup @name={{t "driver-identity.fields.rne-id"}}>
                            <input
                                value={{this.identity.rne_id}}
                                type="text"
                                class="w-full form-input"
                                placeholder={{t "driver-identity.fields.rne-id"}}
                                disabled={{cannot-write @resource}}
                                {{on "input" (fn this.setIdentityField "rne_id")}}
                            />
                        </InputGroup>
                        <InputGroup @name={{t "driver-identity.fields.tax-regime"}}>
                            <select class="w-full form-select form-input" disabled={{cannot-write @resource}} {{on "change" (fn this.setIdentityField "tax_regime")}}>
                                <option value="" selected={{not this.identity.tax_regime}}>{{t "driver-identity.fields.select-tax-regime"}}</option>
                                {{#each this.taxRegimes as |regime|}}
                                    <option value={{regime}} selected={{eq regime this.identity.tax_regime}}>{{t (concat "driver-identity.tax-regimes." regime)}}</option>
                                {{/each}}
                            </select>
                        </InputGroup>
                        <InputGroup @name={{t "driver-identity.fields.rib"}} @helpText={{t "driver-identity.fields.rib-help"}}>
                            <input
                                value={{this.identity.rib}}
                                type="text"
                                inputmode="numeric"
                                maxlength="24"
                                class="w-full form-input"
                                placeholder="00000000000000000000"
                                disabled={{cannot-write @resource}}
                                {{on "input" (fn this.setIdentityField "rib")}}
                            />
                        </InputGroup>
                    {{/if}}
                </div>
                <div class="mt-2 space-y-2">
                    {{#each this.identityDocuments as |document|}}
                        <div class="flex items-center justify-between rounded-md border border-gray-200 dark:border-gray-700 px-3 py-2" data-test-driver-identity-document={{document.kind}}>
                            <div>
                                <div class="font-semibold dark:text-gray-100">{{t (concat "driver-identity.documents." document.kind)}}</div>
                                <div class="text-gray-500 dark:text-gray-400">
                                    {{#if document.uuid}}
                                        <FaIcon @icon="circle-check" class="text-green-500 mr-1" />{{t "driver-identity.document-uploaded"}}
                                    {{else}}
                                        {{t "driver-identity.document-missing"}}
                                    {{/if}}
                                </div>
                            </div>
                            <div class="flex flex-row items-center space-x-1">
                                {{#if document.uuid}}
                                    <Button @type="default" @size="xs" @icon="eye" @text={{t "driver-identity.view-document"}} @onClick={{fn this.viewIdentityDocument document.uuid}} />
                                {{/if}}
                                <UploadButton
                                    @name={{concat "driver-identity-" document.kind}}
                                    @accept={{document.accept}}
                                    @onFileAdded={{perform this.uploadIdentityDocument document.kind}}
                                    @icon="upload"
                                    @size="xs"
                                    @buttonText={{if document.uuid (t "driver-identity.replace-document") (t "driver-identity.upload-document")}}
                                    @disabled={{or (cannot-write @resource) this.uploadIdentityDocument.isRunning}}
                                />
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{/if}}
        </div>
    </ContentPanel>

    {{! ORCHESTRATOR CONSTRAINTS }}
    <ContentPanel @title="Orchestrator Constraints" @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-1">
                Skills & Certifications
            </div>
            <div class="col-span-1 lg:col-span-2">
                <InputGroup @name="Driver Skills" @helpText="Skills and certifications this driver holds (e.g. refrigerated, hazmat, forklift). Used by the Orchestrator for order matching.">
                    <MultiSelect
                        @options={{get-fleet-ops-options "driverSkills"}}
                        @selected={{@resource.skills}}
                        @onChange={{fn (mut @resource.skills)}}
                        @placeholder="Select skills…"
                        @triggerClass="form-select form-input"
                        @disabled={{cannot-write @resource}}
                        as |option|
                    >
                        {{option.label}}
                    </MultiSelect>
                </InputGroup>
            </div>
            <div class="col-span-1 lg:col-span-2 text-[11px] uppercase tracking-wide text-gray-500 font-semibold mt-3">
                Route Limits
            </div>
            <div class="col-span-1 lg:col-span-2 text-xs text-gray-500 dark:text-gray-400 -mt-1">
                Hard caps applied by the Orchestrator when building a single route. These are separate from the driver's shift schedule, which controls availability windows.
            </div>
            <InputGroup
                @name="Max Driving Time (seconds)"
                @helpText="Maximum total driving time in seconds the Orchestrator may assign to this driver in a single route. Leave blank for no limit. Example: 28800 = 8 hours."
            >
                <Input @value={{@resource.max_travel_time}} @type="number" class="form-input w-full" placeholder="e.g. 28800 (8 h)" disabled={{cannot-write @resource}} />
            </InputGroup>
            <InputGroup
                @name="Max Distance (metres)"
                @helpText="Maximum total route distance in metres the Orchestrator may assign to this driver in a single route. Leave blank for no limit."
            >
                <Input @value={{@resource.max_distance}} @type="number" class="form-input w-full" placeholder="e.g. 150000 (150 km)" disabled={{cannot-write @resource}} />
            </InputGroup>
        </div>
    </ContentPanel>

    <CustomField::Yield @subject={{@resource}} @wrapperClass="bordered-top" />

    <RegistryYield @registry="fleet-ops:component:driver:form" as |RegistryComponent|>
        <RegistryComponent @resource={{@resource}} @controller={{this.controller}} @permission={{get-write-permission @resource}} />
    </RegistryYield>

    <ContentPanel @title={{t "avatar-picker.avatar"}} @open={{true}} @wrapperClass="bordered-top">
        <AvatarPicker @model={{@resource}} @defaultAvatar={{config "defaultValues.driverAvatar"}} />
    </ContentPanel>

    <ContentPanel @title={{t "common.metadata"}} @open={{true}} @wrapperClass="bordered-top">
        <MetadataEditor @value={{@resource.meta}} @onChange={{fn (mut @resource.meta)}} />
    </ContentPanel>
</div>