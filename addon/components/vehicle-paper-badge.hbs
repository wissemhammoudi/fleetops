{{#if @status}}
    <span
        class="inline-flex items-center whitespace-nowrap rounded px-1.5 py-0.5 text-[11px] font-semibold
            {{if (eq @status 'expired') 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'}}
            {{if (eq @status 'expiring') 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'}}
            {{if (eq @status 'missing') 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300'}}
            {{if (eq @status 'valid') 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'}}"
        data-test-vehicle-paper-badge={{@status}}
        ...attributes
    >{{t (concat "vehicle-tn.paper-status." @status)}}</span>
{{/if}}