<section class="p-4 space-y-5 overflow-y-auto" aria-label="Email campaigns" {{did-insert this.load}}>
    <header class="flex flex-wrap justify-between items-center gap-3">
        <div>
            <h1 class="text-xl font-semibold dark:text-gray-100">Email campaigns</h1>
            <p class="text-sm text-gray-500">Draft, review and schedule messages. All times use Africa/Tunis.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <Button @text="Refresh campaigns" @disabled={{this.busy}} @onClick={{this.load}} />
            {{#if this.permissions.create}}<Button @text="New campaign" @type="primary" @disabled={{this.busy}} @onClick={{this.newCampaign}} />{{/if}}
        </div>
    </header>
    {{#if this.error}}<p role="alert" class="text-red-500">{{this.error}}</p>{{/if}}
    {{#if this.data}}
        {{#unless this.data.enabled}}<p role="status" class="rounded-lg p-3 bg-yellow-50 text-yellow-900">Campaign sending is disabled in server configuration. Drafts and reviews remain
                available. No email will be sent until the sending configuration is enabled.</p>{{/unless}}
        <div class="grid grid-cols-1 gap-3">
            {{#each this.data.campaigns as |row|}}
                <article class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 flex flex-wrap justify-between gap-3">
                    <div>
                        <h2 class="font-semibold dark:text-gray-100">{{row.name}}</h2>
                        <p>{{humanize row.type}} · {{humanize row.status}} · Version {{row.version}}</p>
                        <p class="text-sm">Next run (UTC): {{or row.next_run_at "Not scheduled"}}</p>
                    </div>
                    <Button @text="Open campaign" @disabled={{or this.busy (not this.permissions.view)}} @onClick={{fn this.open row}} />
                </article>
            {{else}}<p>No campaigns yet.</p>{{/each}}
        </div>
        <div class="flex flex-wrap gap-2 items-center">
            <Button @text="Previous campaigns" @disabled={{or this.firstPage this.busy}} @onClick={{fn this.changePage -1}} />
            <span>Page {{this.page}} / {{or this.data.last_page 1}}</span>
            <Button @text="Next campaigns" @disabled={{or this.lastPage this.busy}} @onClick={{fn this.changePage 1}} />
        </div>
    {{else}}
        {{#if this.busy}}<p role="status">Loading campaigns...</p>{{/if}}
    {{/if}}

    {{#if this.editing}}
        <section aria-label="Campaign editor" class="rounded-xl border border-gray-200 dark:border-gray-700 p-4 space-y-4">
            <div class="flex flex-wrap justify-between gap-2">
                <h2 class="text-lg font-semibold dark:text-gray-100">{{if this.hasSaved this.detail.campaign.name "New campaign draft"}}</h2>
                <Button @text="Close and discard unsaved changes" @disabled={{this.busy}} @onClick={{this.discard}} />
            </div>
            {{#if this.hasSaved}}<p>Saved status: <strong>{{humanize this.detail.campaign.status}}</strong> · Version {{this.detail.campaign.version}}</p>{{/if}}
            {{#if this.dirty}}<p role="status">Unsaved changes. Save before requesting approval or sending. Editing an approved campaign invalidates its approval.</p>{{/if}}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <label>Internal campaign name
                    <input
                        aria-label="Campaign name"
                        class="form-input w-full"
                        maxlength="160"
                        value={{this.name}}
                        disabled={{or this.busy (not this.canEdit)}}
                        {{on "input" (fn this.field "name")}}
                    />
                </label>
                <label>Purpose
                    <select aria-label="Campaign purpose" class="form-select w-full" disabled={{or this.busy (not this.canEdit)}} {{on "change" (fn this.field "type")}}>
                        <option value="marketing" selected={{eq this.type "marketing"}}>Marketing: recorded opt-in only</option>
                        <option value="operational" selected={{eq this.type "operational"}}>Operational: relevant service contacts only</option>
                    </select>
                </label>
            </div>
            <p class="text-sm text-gray-500">Website forms and driver applications do not automatically subscribe people. Operational messages must be relevant service notices, never
                promotions disguised as notices.</p>
            <fieldset class="space-y-2">
                <legend class="font-semibold">Audience groups</legend>
                <div class="flex flex-wrap gap-4">
                    {{#each this.audiences as |item|}}
                        <label class="flex items-center gap-2"><input
                                type="checkbox"
                                checked={{item.selected}}
                                disabled={{or this.busy (not this.canEdit)}}
                                {{on "change" (fn this.toggleAudience item.value)}}
                            />{{item.label}}</label>
                    {{/each}}
                </div>
                <p class="text-xs text-gray-500">Groups use registered contacts with recorded eligibility, not every email in the database. Group selection and explicitly selected contacts
                    are deduplicated. Consent and suppressions are checked again before each delivery.</p>
                <p class="text-sm">Explicitly selected contacts: {{this.selectedContacts.length}}. Use the audience register below to select individual recipients.</p>
            </fieldset>
            <div class="flex flex-wrap gap-3 items-end">
                <label>Editing language
                    <select aria-label="Campaign language" class="form-select block" {{on "change" (fn this.field "language")}}>
                        <option value="fr" selected={{eq this.language "fr"}}>Français</option><option value="en" selected={{eq this.language "en"}}>English</option><option
                            value="ar"
                            selected={{eq this.language "ar"}}
                        >العربية</option>
                    </select>
                </label>
                <Button @text={{if this.preview "Edit campaign text" "Preview campaign"}} @onClick={{this.togglePreview}} />
            </div>
            {{#if this.preview}}
                <article aria-label="Campaign preview" lang={{this.language}} dir={{this.direction}} class="rounded-lg border border-gray-200 bg-white text-gray-900 overflow-hidden">
                    <div class="bg-gray-900 text-white p-5"><p class="font-bold text-lg">Colab Express</p></div>
                    <div class="p-5 space-y-3">
                        <h3 class="font-semibold">{{this.currentVariant.subject}}</h3>
                        <p class="whitespace-pre-wrap break-words" dir="auto">{{this.currentVariant.body}}</p>
                    </div>
                    <footer class="bg-gray-50 p-4 text-sm">Each recipient receives their own message.
                        {{#if (eq this.type "marketing")}}A personal unsubscribe link is added automatically.{{/if}}</footer>
                </article>
            {{else}}
                <label class="block">Email subject
                    <input
                        aria-label="Campaign subject"
                        class="form-input w-full"
                        maxlength="200"
                        value={{this.currentVariant.subject}}
                        disabled={{or this.busy (not this.canEdit)}}
                        {{on "input" (fn this.variant "subject")}}
                    />
                </label>
                <label class="block">Email message
                    <textarea
                        aria-label="Campaign body"
                        class="form-input w-full leading-relaxed"
                        rows="10"
                        maxlength="20000"
                        dir="auto"
                        value={{this.currentVariant.body}}
                        disabled={{or this.busy (not this.canEdit)}}
                        {{on "input" (fn this.variant "body")}}
                    ></textarea>
                </label>
                <p class="text-xs text-gray-500">Provide at least one complete subject/message variant. Missing recipient languages use the server's defined fallback; changing this selector
                    never translates text.</p>
            {{/if}}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <label>Schedule
                    <select aria-label="Campaign schedule" class="form-select w-full" disabled={{or this.busy (not this.canEdit)}} {{on "change" (fn this.field "scheduleType")}}>
                        <option value="now" selected={{eq this.scheduleType "now"}}>Send after manager approval and start</option>
                        <option value="once" selected={{eq this.scheduleType "once"}}>Schedule once</option>
                        <option value="recurring" selected={{eq this.scheduleType "recurring"}}>Recurring campaign</option>
                    </select>
                </label>
                {{#if this.needsDate}}
                    <label>First run (Africa/Tunis)<input
                            aria-label="Campaign first run"
                            type="datetime-local"
                            class="form-input w-full"
                            value={{this.scheduledAt}}
                            disabled={{or this.busy (not this.canEdit)}}
                            {{on "input" (fn this.field "scheduledAt")}}
                        /></label>
                {{/if}}
                {{#if this.isRecurring}}
                    <label>Repeat
                        <select aria-label="Campaign recurrence" class="form-select w-full" disabled={{or this.busy (not this.canEdit)}} {{on "change" (fn this.field "recurrence")}}>
                            <option value="daily" selected={{eq this.recurrence "daily"}}>Daily</option><option value="weekly" selected={{eq this.recurrence "weekly"}}>Weekly</option><option
                                value="monthly"
                                selected={{eq this.recurrence "monthly"}}
                            >Monthly</option>
                        </select>
                    </label>
                    <label>Maximum runs<input
                            aria-label="Maximum campaign runs"
                            type="number"
                            min="1"
                            max="366"
                            class="form-input w-full"
                            value={{this.maxOccurrences}}
                            disabled={{or this.busy (not this.canEdit)}}
                            {{on "input" (fn this.field "maxOccurrences")}}
                        /></label>
                    <label>End date (Africa/Tunis, optional with maximum runs)<input
                            aria-label="Campaign end date"
                            type="datetime-local"
                            class="form-input w-full"
                            value={{this.endsAt}}
                            disabled={{or this.busy (not this.canEdit)}}
                            {{on "input" (fn this.field "endsAt")}}
                        /></label>
                {{/if}}
            </div>
            <div class="flex flex-wrap gap-2">
                {{#if this.canEdit}}<Button @text="Save campaign draft" @type="primary" @disabled={{this.busy}} @onClick={{this.save}} />{{/if}}
                {{#if this.canSubmit}}<Button @text="Submit for approval" @disabled={{this.busy}} @onClick={{fn this.transition "submit"}} />{{/if}}
                {{#if this.canApprove}}<Button @text="Approve campaign" @disabled={{this.busy}} @onClick={{fn this.transition "approve"}} />{{/if}}
                {{#if this.canSend}}<Button @text="Start approved schedule" @disabled={{or this.busy (not this.data.enabled)}} @onClick={{fn this.transition "send"}} />{{/if}}
                {{#if this.canPause}}<Button @text="Pause campaign" @disabled={{this.busy}} @onClick={{fn this.transition "pause"}} />{{/if}}
                {{#if this.canCancel}}<Button @text="Cancel campaign" @disabled={{this.busy}} @onClick={{fn this.transition "cancel"}} />{{/if}}
                {{#if (and this.hasSaved this.permissions.test)}}<Button
                        @text="Send test to my staff email"
                        @disabled={{or this.busy this.dirty (not this.data.enabled)}}
                        @onClick={{fn this.transition "test"}}
                    />{{/if}}
            </div>
            <p class="text-sm">Approval must come from another staff member. Starting uses the saved audience and schedule; a scheduled run is not proof of delivery. Test mail goes only to
                your own staff email.</p>
            {{#if this.detail}}
                <p>Eligible audience: {{or this.detail.eligible_count 0}} · Next run (UTC): {{or this.detail.campaign.next_run_at "Not scheduled"}}</p>
                <div class="flex flex-wrap gap-3">{{#each this.counts as |count|}}<span>{{humanize count.status}}: {{count.count}}</span>{{/each}}</div>
                <h3 class="font-semibold">Recent activity</h3>
                {{#each this.detail.events as |event|}}<p class="text-sm break-words">{{event.created_at}} · {{event.action}} · {{or event.actor_name event.actor_uuid}}</p>{{else}}<p>No
                        campaign actions yet.</p>{{/each}}
                <h3 class="font-semibold">Recent delivery attempts</h3>
                {{#each this.detail.deliveries as |delivery|}}<p class="text-sm break-words">{{delivery.email}} · {{humanize delivery.status}}</p>{{else}}<p>No delivery attempts yet.</p>{{/each}}
            {{/if}}
        </section>
    {{/if}}

    {{#if this.permissions.view}}
        <section aria-label="Audience register" class="rounded-xl border border-gray-200 dark:border-gray-700 p-4 space-y-3">
            <h2 class="text-lg font-semibold dark:text-gray-100">Audience register</h2>
            <div class="flex flex-wrap gap-2 items-end">
                <label>Find a registered email<input
                        aria-label="Audience search"
                        class="form-input block"
                        value={{this.contactSearch}}
                        {{on "input" (fn this.field "contactSearch")}}
                    /></label>
                <Button @text="Load audience" @disabled={{this.busy}} @onClick={{fn this.loadContacts 0}} />
            </div>
            {{#each this.contactRows as |contact|}}
                <label class="block p-3 rounded-lg border border-gray-200 dark:border-gray-700">
                    {{#if this.editing}}<input
                            type="checkbox"
                            checked={{contact.selected}}
                            disabled={{or this.busy (not this.canEdit)}}
                            {{on "change" (fn this.toggleContact contact.uuid)}}
                        />{{/if}}
                    {{contact.email}}
                    ·
                    {{contact.name}}
                    ·
                    {{contact.audience}}
                    ·
                    {{contact.locale}}
                    <span class="block text-sm">Marketing consent: {{or contact.consented_at "Not recorded"}} · Operational eligibility: {{if contact.operational "Yes" "No"}}</span>
                </label>
            {{else}}<p>Load registered contacts to inspect eligibility or select individual recipients.</p>{{/each}}
            <div class="flex flex-wrap gap-2 items-center">
                <Button @text="Previous contacts" @disabled={{or this.busy this.firstContactsPage}} @onClick={{fn this.loadContacts -1}} />
                <span>Page {{this.contactsPage}} / {{this.contactsLastPage}}</span>
                <Button @text="Next contacts" @disabled={{or this.busy this.lastContactsPage}} @onClick={{fn this.loadContacts 1}} />
            </div>
        </section>
    {{/if}}
    {{#if this.permissions.import}}
        <section aria-label="Audience import" class="rounded-xl border border-gray-200 dark:border-gray-700 p-4 space-y-3">
            <h2 class="text-lg font-semibold dark:text-gray-100">Register or import contacts</h2>
            <p class="text-sm">Paste up to 500 spreadsheet rows: email, then an optional name separated by a tab. No header. One row can register a single contact. Only import people you are
                authorized to contact.</p>
            <textarea aria-label="Import contacts" class="form-input w-full" rows="5" value={{this.importText}} disabled={{this.busy}} {{on "input" (fn this.field "importText")}}></textarea>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <label>Audience group
                    <select aria-label="Import audience" class="form-select w-full" {{on "change" (fn this.field "importAudience")}}>
                        {{#each this.audiences as |item|}}<option value={{item.value}} selected={{eq this.importAudience item.value}}>{{item.label}}</option>{{/each}}
                    </select>
                </label>
                <label>Preferred language
                    <select aria-label="Import language" class="form-select w-full" {{on "change" (fn this.field "importLanguage")}}>
                        <option value="fr" selected={{eq this.importLanguage "fr"}}>Français</option><option value="en" selected={{eq this.importLanguage "en"}}>English</option><option
                            value="ar"
                            selected={{eq this.importLanguage "ar"}}
                        >العربية</option>
                    </select>
                </label>
            </div>
            <label class="block"><input type="checkbox" checked={{this.importConsent}} {{on "change" (fn this.checkbox "importConsent")}} />
                I have evidence these contacts opted in to marketing.</label>
            {{#if this.importConsent}}
                <label class="block">Consent evidence / source<input
                        aria-label="Consent source"
                        class="form-input w-full"
                        value={{this.consentSource}}
                        {{on "input" (fn this.field "consentSource")}}
                    /></label>
                <label class="block">Consent recorded at (include timezone, for example 2026-11-02T10:00:00+01:00)<input
                        aria-label="Consent timestamp"
                        class="form-input w-full"
                        value={{this.consentedAt}}
                        {{on "input" (fn this.field "consentedAt")}}
                    /></label>
            {{/if}}
            <label class="block"><input type="checkbox" checked={{this.importOperational}} {{on "change" (fn this.checkbox "importOperational")}} />
                These contacts have a relevant service relationship for operational notices.</label>
            <Button @text="Import audience records" @disabled={{this.busy}} @onClick={{this.importContacts}} />
            {{#if this.importResult}}
                <p role="status">Imported: {{or this.importResult.imported 0}}. Review any rejected rows:</p>
                {{#each this.importResult.errors as |error|}}<p role="alert" class="text-red-500">Row {{error.row}}: {{error.message}}</p>{{/each}}
            {{/if}}
            <h3 class="font-semibold">Suppress future email</h3>
            <p class="text-sm">Record mailbox/provider complaints, hard bounces or unsubscribe requests. Importing the address again must not silently clear suppression.</p>
            <label class="block">Email<input
                    aria-label="Suppression email"
                    type="email"
                    class="form-input w-full"
                    value={{this.suppressionEmail}}
                    {{on "input" (fn this.field "suppressionEmail")}}
                /></label>
            <label class="block">Reason
                <select aria-label="Suppression reason" class="form-select w-full" {{on "change" (fn this.field "suppressionReason")}}>
                    <option value="unsubscribe">Unsubscribe</option><option value="hard_bounce">Hard bounce</option><option value="complaint">Complaint</option>
                </select>
            </label>
            <Button @text="Suppress email address" @disabled={{this.busy}} @onClick={{this.suppress}} />
        </section>
    {{/if}}
</section>