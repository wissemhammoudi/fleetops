<section class="space-y-4" aria-label={{t "pickup-details.title"}} data-test-pickup-overview {{did-insert this.start}} {{did-update this.start @round.uuid this.currentUser.companyId}}>
    <div class="rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 p-4">
        <div class="flex items-start justify-between gap-3">
            <div>
                <h3 class="font-semibold text-lg">{{t "pickup-details.title"}}</h3>
                <p class="text-sm text-gray-500">{{this.departure}} · {{this.round.timezone}}</p>
            </div>
            <Badge @status={{this.round.status}} />
        </div>
        <div class="grid grid-cols-2 gap-3 mt-4">
            <div><p class="text-xs text-gray-500">{{t "pickup-details.driver"}}</p><p class="font-semibold">{{if this.driver.name this.driver.name (t "pickup-details.unassigned")}}</p></div>
            <div><p class="text-xs text-gray-500">{{t "pickup-details.progress"}}</p><p class="font-semibold">{{this.completed}} / {{this.round.stops.length}}</p></div>
            <div><p class="text-xs text-gray-500">{{t "pickup-details.connection"}}</p><p data-test-driver-presence>{{this.onlineLabel}}</p></div>
            <div><p class="text-xs text-gray-500">{{t "pickup-details.activity"}}</p><p>{{if this.driver.status this.driver.status (t "pickup-details.unknown")}}</p></div>
        </div>
        {{#if this.driverCall}}<a href={{this.driverCall}} class="inline-block mt-3 text-blue-600">{{t "pickup-details.call-driver"}}</a>{{/if}}
    </div>
    <div class="flex items-center justify-between gap-3 text-xs text-gray-500">
        <span>{{t "pickup-details.auto-refresh"}} · {{t "pickup-details.updated"}}: {{this.updatedAt}}</span>
        <Button @text={{t "collection-rounds.refresh"}} @onClick={{this.refresh}} @disabled={{this.loading}} />
    </div>
    {{#if this.error}}<p role="alert" class="text-red-500" data-test-monitor-error>{{this.error}}</p>{{/if}}
    {{#if this.hasMap}}
        <div class="h-64 rounded-lg overflow-hidden border dark:border-gray-700">
            <PlanningMap @routes={{this.mapRoutes}} @driver={{this.driverMarker}} @fitRoute={{true}} />
        </div>
    {{else}}<p class="text-sm text-gray-500">{{t "pickup-details.map-unavailable"}}</p>{{/if}}
    <p class="text-xs text-gray-500" data-test-driver-position>{{this.positionLabel}} · {{t "pickup-details.last-position"}}: {{this.positionAt}}</p>
    <div class="rounded-lg border border-gray-200 dark:border-gray-700 p-4 space-y-3">
        <h3 class="font-semibold">{{t "pickup-details.itinerary"}}</h3>
        <p class="text-sm text-gray-500">{{t "pickup-details.estimates"}}</p>
        <div class="border-l-2 border-indigo-400 pl-4">
            <p class="text-xs font-semibold text-indigo-500">{{t "planning.vehicle-start"}}</p>
            <p>{{this.originLabel}}</p><p class="text-xs text-gray-500">{{this.departure}}</p>
        </div>
        {{#each this.itinerary as |stop|}}
            <div class="border-l-2 border-gray-200 dark:border-gray-700 pl-4 py-2" data-test-itinerary-stop>
                <div class="flex items-center gap-2"><span class="font-semibold text-indigo-500">{{stop.sequence}}.</span><strong>{{stop.order_id}}</strong>{{#if stop.status}}<Badge
                            @status={{stop.status}}
                        />{{/if}}</div>
                <p class="text-sm">{{stop.label}}</p>
                {{#if stop.time}}<p class="text-xs text-gray-500">{{stop.time}}</p>{{/if}}
                {{#if stop.callUrl}}<a href={{stop.callUrl}} class="text-sm text-blue-600">{{t "collection-rounds.call-customer"}}</a>{{/if}}
                {{#if stop.handover}}<p class="text-xs">{{t "pickup-handover.title"}}: {{t (concat "pickup-handover." stop.handover.status)}}</p>{{/if}}
            </div>
        {{/each}}
        <div class="border-l-2 border-violet-500 pl-4"><p class="text-xs font-semibold text-violet-500">{{t "collection-rounds.depot"}}</p><p>{{this.depotLabel}}</p><p
                class="text-xs text-gray-500"
            >{{this.endTime}}</p></div>
    </div>
</section>